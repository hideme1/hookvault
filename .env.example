# ─── HookVault Environment Variables ───

# Database (SQLite file path for local dev)
DATABASE_URL=./data/hookvault.db

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-hex-string
BETTER_AUTH_URL=http://localhost:3000

# AES-256-GCM encryption key for endpoint signing secrets (64 hex chars = 32 bytes)
ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# SSRF: allow http:// targets in test mode only (NEVER in production)
ALLOW_LOCAL_TARGETS=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Server
PORT=3000
NODE_ENV=development
